# Copy to .env and adjust. All settings are optional.

# LLM served by Ollama
OLLAMA_MODEL_NAME=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
# Context window (tokens); must fit retrieved passages + chat history
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded between questions
OLLAMA_KEEP_ALIVE=30m

# Embeddings: "huggingface" (in-process) or "ollama"
# Changing these requires re-ingesting your documents.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=nomic-embed-text

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_K=6
# similarity | mmr | hybrid (keywords + vectors)
RETRIEVAL_MODE=hybrid
# Rerank passages with a cross-encoder (downloads ~90 MB on first use)
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
MAX_HISTORY_MESSAGES=6

# Storage locations (relative paths are resolved against the project root).
# Ignored by Docker Compose, which keeps these on its volumes.
DATA_DIR=data
CHROMA_DB_DIR=chroma_db
CHAT_DB_PATH=chat_history.db
# Google Drive OAuth files
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=token.json
